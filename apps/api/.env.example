DATABASE_URL="postgresql://medline:medline@localhost:5432/medline_ops?schema=public"
API_PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGIN="http://localhost:3000"

# File storage (S3). Leave unset to disable uploads in local dev — the API
# returns 503 "storage not configured" on presign calls. Credentials are read
# from the AWS SDK default chain (AWS_ACCESS_KEY_ID/SECRET env vars or IAM role).
AWS_REGION=""
S3_BUCKET=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Outbound messaging. Unset providers are skipped — automations still write the
# in-app notification row, they just don't send externally.
# Email (Resend):
RESEND_API_KEY=""
EMAIL_FROM=""               # e.g. "Medline Ops <noreply@medline.example>"
# SMS + WhatsApp (Twilio):
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""          # e.g. +14155550100
TWILIO_WHATSAPP_FROM=""     # e.g. +14155550100 (a WhatsApp-enabled Twilio number)

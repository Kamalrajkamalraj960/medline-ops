# Production environment for docker-compose.prod.yml
# Copy to .env.prod and replace every value. NEVER commit the real file.

# --- Database ---
DATABASE_URL="postgresql://postgres.xlqggxyjrorubbtnrwrb:[YOUR-DB-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xlqggxyjrorubbtnrwrb:[YOUR-DB-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"
# --- JWT secrets (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=CHANGE_ME_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Public URLs (what the browser/users hit) ---
# The web app's browser bundle calls PUBLIC_API_URL; the API allows CORS from PUBLIC_WEB_URL.
PUBLIC_WEB_URL=https://app.medline.example
PUBLIC_API_URL=https://api.medline.example/api/v1

# --- File storage (S3) ---
# Prefer an IAM role over static keys in production.
AWS_REGION=ap-south-1
S3_BUCKET=medline-documents-prod
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

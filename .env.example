# Copy to .env (root) — read by the API (Prisma) and the seed script.

# --- Database: Supabase PostgreSQL ---
# Find these under Supabase → Project Settings → Database → Connection string.
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.xlqggxyjrorubbtnrwrb:[YOUR-DB-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by Prisma for db push / migrations.
DIRECT_URL="postgresql://postgres.xlqggxyjrorubbtnrwrb:[YOUR-DB-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# API
API_PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGIN="http://localhost:3000"

# File storage (S3). Leave unset to disable document uploads locally.
AWS_REGION=""
S3_BUCKET=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Web (Next.js) — must be prefixed NEXT_PUBLIC to reach the browser
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

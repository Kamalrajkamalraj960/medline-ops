generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  label       String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  /// Format: "<resource>:<action>" e.g. "lead:create", "report:export"
  key         String           @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Department {
  id        String         @id @default(cuid())
  name      DepartmentName @unique
  label     String
  createdAt DateTime       @default(now())
  users     User[]
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  username       String?        @unique
  passwordHash   String
  status         UserStatus     @default(ACTIVE)
  roleId         String
  departmentId   String?
  phone          String?
  avatarUrl      String?
  lastLoginAt    DateTime?
  portalLeadId   String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  auditLogs      AuditLog[]
  createdLeads   Lead[]         @relation("LeadCreator")
  assignedLeads  Lead[]         @relation("LeadOwner")
  leadActivities LeadActivity[]
  notifications  Notification[]
  sessions       Session[]
  tasksAssigned  Task[]         @relation("TaskAssignee")
  tasksCreated   Task[]         @relation("TaskCreator")
  department     Department?    @relation(fields: [departmentId], references: [id])
  portalLead     Lead?          @relation("PortalUser", fields: [portalLeadId], references: [id])
  role           Role           @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([departmentId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LeadSource {
  id        String     @id @default(cuid())
  name      String     @unique
  channel   String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  campaigns Campaign[]
  leads     Lead[]
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  type        String
  status      CampaignStatus @default(DRAFT)
  serviceType ServiceType?
  sourceId    String?
  budget      Decimal?       @db.Decimal(12, 2)
  spend       Decimal?       @db.Decimal(12, 2)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  source      LeadSource?    @relation(fields: [sourceId], references: [id])
  leads       Lead[]
}

model CreativeAsset {
  id        String   @id @default(cuid())
  name      String
  type      String
  category  String?
  url       String?
  tags      String[] @default([])
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id                   String           @id @default(cuid())
  /// Human-friendly reference, e.g. LD-2026-0001
  reference            String           @unique
  name                 String
  phone                String
  whatsapp             String?
  email                String?
  gender               String?
  country              String?
  city                 String?
  dateOfBirth          DateTime?
  nationality          String?
  profession           String?
  experienceYears      Int?
  currentEmployer      String?
  highestQualification String?
  currentCountry       String?
  preferredDestination String?
  serviceType          ServiceType
  urgency              Urgency?
  leadSource           String?
  sourceDetails        String?
  sourceId             String?
  campaignId           String?
  tags                 String[]         @default([])
  remarks              String?
  status               LeadStatus       @default(NEW)
  priority             Priority         @default(MEDIUM)
  ownerId              String?
  createdById          String?
  passport             String?
  nationalId           String?
  /// Set true for legacy records that arrived as service_type='both'.
  /// New records can NEVER set this; it exists only for migration triage.
  legacyBothFlag       Boolean          @default(false)
  nextFollowUpAt       DateTime?
  convertedAt          DateTime?
  lostReason           String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  student              AcademyStudent?
  case                 ConsultancyCase?
  campaign             Campaign?        @relation(fields: [campaignId], references: [id])
  createdBy            User?            @relation("LeadCreator", fields: [createdById], references: [id])
  owner                User?            @relation("LeadOwner", fields: [ownerId], references: [id])
  source               LeadSource?      @relation(fields: [sourceId], references: [id])
  activities           LeadActivity[]
  portalUser           User?            @relation("PortalUser")

  @@index([status])
  @@index([serviceType])
  @@index([ownerId])
  @@index([phone])
  @@index([email])
}

model LeadActivity {
  id          String    @id @default(cuid())
  leadId      String
  type        String
  notes       String?
  outcome     String?
  scheduledAt DateTime?
  completedAt DateTime?
  actorId     String?
  createdAt   DateTime  @default(now())
  actor       User?     @relation(fields: [actorId], references: [id])
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model ConsultancyCase {
  id                String             @id @default(cuid())
  reference         String             @unique
  leadId            String             @unique
  authority         String
  profession        String?
  status            CaseStatus         @default(DOCUMENT_COLLECTION)
  priority          Priority           @default(MEDIUM)
  progressPct       Int                @default(0)
  assignedOfficerId String?
  openedAt          DateTime           @default(now())
  closedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  authorityTracking AuthorityTracking?
  lead              Lead               @relation(fields: [leadId], references: [id])
  documents         Document[]

  @@index([status])
  @@index([authority])
}

model Document {
  id              String            @id @default(cuid())
  caseId          String
  category        String
  fileUrl         String?
  status          DocumentStatus    @default(MISSING)
  reviewerId      String?
  rejectionReason String?
  expiresAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  case            ConsultancyCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  versions        DocumentVersion[]

  @@index([caseId])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  version      Int
  fileUrl      String
  uploadedById String?
  createdAt    DateTime @default(now())
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model AuthorityTracking {
  id              String              @id @default(cuid())
  caseId          String              @unique
  authority       String
  referenceNumber String?
  status          AuthorityStatus     @default(NOT_STARTED)
  submissionDate  DateTime?
  expectedCompletionDate DateTime?
  lastResponseAt  DateTime?
  notes           String?
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  followUps       AuthorityFollowUp[]
  case            ConsultancyCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model AuthorityFollowUp {
  id          String            @id @default(cuid())
  trackingId  String
  type        String
  dueAt       DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime          @default(now())
  tracking    AuthorityTracking @relation(fields: [trackingId], references: [id], onDelete: Cascade)

  @@index([trackingId])
}

model AcademyCourse {
  id            String           @id @default(cuid())
  name          String
  description   String?
  category      String?
  profession    String?
  level         String?
  durationWeeks Int?
  price         Decimal?         @db.Decimal(12, 2)
  thumbnailUrl  String?
  learningObjectives String[]    @default([])
  syllabus      String?
  isActive      Boolean          @default(true)
  archivedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  batches       AcademyBatch[]
  students      AcademyStudent[]
}

model AcademyFaculty {
  id              String         @id @default(cuid())
  name            String
  specialization  String?
  experienceYears Int?
  rating          Float?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  batches         AcademyBatch[]
}

model AcademyBatch {
  id        String           @id @default(cuid())
  code      String           @unique
  courseId  String
  facultyId String?
  startDate DateTime?
  endDate   DateTime?
  timing    String?
  seatLimit Int              @default(0)
  status    BatchStatus      @default(UPCOMING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  course    AcademyCourse    @relation(fields: [courseId], references: [id])
  faculty   AcademyFaculty?  @relation(fields: [facultyId], references: [id])
  students  AcademyStudent[]
}

model AcademyStudent {
  id                  String         @id @default(cuid())
  reference           String         @unique
  leadId              String?        @unique
  name                String
  courseId            String?
  batchId             String?
  status              StudentStatus  @default(ENROLLED)
  progressPct         Int            @default(0)
  attendancePct       Int            @default(0)
  enrolledAt          DateTime       @default(now())
  certificateIssuedAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  batch               AcademyBatch?  @relation(fields: [batchId], references: [id])
  lead                Lead?          @relation(fields: [leadId], references: [id])
  course              AcademyCourse? @relation(fields: [courseId], references: [id], map: "student_course_fk")

  @@index([batchId])
}

model DemoSession {
  id                String    @id @default(cuid())
  leadName          String
  coordinatorId     String?
  scheduledAt       DateTime?
  outcome           String?
  likelihood        Int?
  recommendedCourse String?
  createdAt         DateTime  @default(now())
}

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique
  clientName String
  leadId     String?
  amount     Decimal       @db.Decimal(12, 2)
  gstAmount  Decimal       @default(0) @db.Decimal(12, 2)
  status     InvoiceStatus @default(DRAFT)
  issuedAt   DateTime?
  dueAt      DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  payments   Payment[]
}

model Payment {
  id                String        @id @default(cuid())
  reference         String        @unique
  payerName         String
  payerId           String?
  invoiceId         String?
  leadId            String?
  studentId         String?
  courseId          String?
  amount            Decimal       @db.Decimal(12, 2)
  method            PaymentMethod
  type              PaymentType   @default(OTHER)
  status            PaymentStatus @default(PENDING)
  transactionRef    String?
  installmentNumber Int?
  notes             String?
  proofUrl          String?
  paymentDate       DateTime?
  paidAt            DateTime?
  verifiedAt        DateTime?
  verifiedById      String?
  confirmedAt       DateTime?
  confirmedById     String?
  rejectedAt        DateTime?
  rejectedById      String?
  rejectionReason   String?
  // Append-only status/verification trail. Stored as JSON to mirror the
  // embedded array the app reads/writes as `payment.history`.
  history           Json          @default("[]")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  invoice           Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([leadId])
  @@index([studentId])
  @@index([courseId])
}

model Refund {
  id            String       @id @default(cuid())
  clientName    String
  amount        Decimal      @db.Decimal(12, 2)
  reason        String?
  requestedById String?
  status        RefundStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  processedAt   DateTime?
}

model AuthorityPayment {
  id         String    @id @default(cuid())
  clientName String
  authority  String
  type       String
  amount     Decimal   @db.Decimal(12, 2)
  paidAt     DateTime?
  /// Whether the fee paid to the authority has been recovered from the client.
  recovered  Boolean   @default(false)
  status     String    @default("PENDING")
  caseId     String?
  createdAt  DateTime  @default(now())
}

model Task {
  id          String          @id @default(cuid())
  title       String
  description String?
  status      TaskStatus      @default(NEW)
  priority    Priority        @default(MEDIUM)
  department  DepartmentName?
  assigneeId  String?
  createdById String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  assignee    User?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy   User?           @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([assigneeId])
  @@index([status])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  event     String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AutomationRule {
  id         String   @id @default(cuid())
  name       String
  trigger    String
  definition Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  resource   String
  resourceId String?
  oldValue   Json?
  newValue   Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([resource])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

/// The ONLY allowed service types. "both" is intentionally absent and must
/// never be reintroduced. Legacy "both" rows are migrated to a flagged state
/// via Lead.legacyBothFlag, not by adding an enum value.
enum ServiceType {
  consultancy
  academy
}

enum RoleName {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  SALES_MANAGER
  SALES_EXECUTIVE
  DOCUMENTATION_TEAM
  ACADEMY_HEAD
  ACCOUNTS
  MARKETING
  CLIENT
}

enum DepartmentName {
  ADMINISTRATION
  OPERATIONS
  SALES
  DOCUMENTATION
  ACADEMY
  ACCOUNTS
  MARKETING
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  DEMO_SCHEDULED
  DEMO_COMPLETED
  DOCUMENTATION
  CONVERTED
  LOST
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum Urgency {
  IMMEDIATE
  WITHIN_3_MONTHS
  WITHIN_6_MONTHS
  JUST_EXPLORING
}

enum TaskStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum CaseStatus {
  DOCUMENT_COLLECTION
  VERIFICATION
  READY_FOR_SUBMISSION
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_DOCS_REQUIRED
  ELIGIBILITY_RECEIVED
  EXAM_SCHEDULED
  EXAM_PASSED
  LICENSE_PROCESSING
  COMPLETED
  REJECTED
  CLOSED
  ARCHIVED
}

enum DocumentStatus {
  MISSING
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  RESUBMISSION_REQUIRED
}

enum AuthorityStatus {
  NOT_STARTED
  PREPARING
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_DOCS_REQUESTED
  ELIGIBILITY_ISSUED
  EXAM_SCHEDULED
  APPROVED
  REJECTED
  CLOSED
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StudentStatus {
  ENROLLED
  ACTIVE
  COMPLETED
  DROPPED
  ON_HOLD
  CANCELLED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  CONFIRMED
  REJECTED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
  CASH
  ONLINE_GATEWAY
  CHEQUE
  CARD
  STRIPE
  OTHER
}

enum PaymentType {
  CONSULTANCY
  ACADEMY
  CRM
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
  PUSH
}

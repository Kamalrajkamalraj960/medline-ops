{
  "name": "medline-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Medline Ops — Enterprise SaaS platform for healthcare licensing consultancy & academy operations.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:generate": "npm run generate -w @medline/db",
    "db:migrate": "npm run migrate -w @medline/db",
    "db:push": "npm run push -w @medline/db",
    "db:seed": "npm run seed -w @medline/db",
    "db:studio": "npm run studio -w @medline/db",
    "dev:api": "npm run dev -w @medline/api",
    "dev:web": "npm run dev -w @medline/web",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run build -w @medline/db && npm run build -w @medline/api && npm run build -w @medline/web",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

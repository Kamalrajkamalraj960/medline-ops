# Normalize line endings: store text as LF in the repo and check out LF on all
# platforms, so Windows CRLF auto-conversion doesn't create spurious diffs.
* text=auto eol=lf

# Scripts must stay LF regardless of platform.
*.sh   text eol=lf
*.mjs  text eol=lf

# Binary assets — never apply EOL conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.pdf  binary

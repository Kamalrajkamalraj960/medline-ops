{
  "name": "medline-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Medline Ops — Enterprise SaaS platform for healthcare licensing consultancy & academy operations.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "db:seed": "npm run seed -w @medline/db",
    "dev:api": "npm run dev -w @medline/api",
    "dev:web": "npm run dev -w @medline/web",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run build -w @medline/db && npm run build -w @medline/api && npm run build -w @medline/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
